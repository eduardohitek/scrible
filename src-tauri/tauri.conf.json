{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "scrible",
  "version": "../package.json",
  "identifier": "com.hitek.scrible",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "scrible",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDNUQ3RkE4NUM2NjQzRApSV1E5Wk1hRit0ZkZEZS9ZczdwdTEyQ1JocWp3QU5YODBHRzFCRGJhMEFSNFBNOGR5YzFPYXlUbwo=",
      "endpoints": [
        "https://github.com/eduardohitek/scrible/releases/latest/download/latest.json"
      ]
    }
  }
}
